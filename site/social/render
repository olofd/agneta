#!/bin/sh
# Renders site/social/social-preview.html to docs/images/social-preview.png (1280 × 640), the image GitHub shows
# when the repository is shared and the site's og:image. Uses the Google Chrome installed on this Mac, headless,
# with a throwaway profile; it quits once the image is written.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[ -x "$chrome" ] || { echo "render: needs Google Chrome in /Applications" >&2; exit 1; }
profile=$(mktemp -d)
trap 'rm -rf "$profile"' EXIT
"$chrome" --headless --disable-gpu --hide-scrollbars --no-first-run --user-data-dir="$profile" \
  --force-device-scale-factor=1 --window-size=1280,640 --default-background-color=00000000 \
  --screenshot="$root/docs/images/social-preview.png" "file://$here/social-preview.html" 2>/dev/null
sips -g pixelWidth -g pixelHeight "$root/docs/images/social-preview.png" | tail -2
