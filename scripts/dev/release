#!/bin/bash
# Builds a release of Agneta for this Mac's architecture (docs/RELEASING.md): build/Agneta.app signed with the
# Developer ID, notarized and stapled; a DMG of it, signed, notarized and stapled too; a zip of the app for Sparkle;
# their SHA-256 sums; and a smoke test of the DMG as a user downloads it. Everything lands in build/release/.
#   scripts/dev/release [--engines all|goose] [--previous <Agneta.zip>]
# AGNETA_VERSION: the version, else the v* tag on this commit. A signed release must have one.
# AGNETA_SIGN_IDENTITY: a "Developer ID Application: …" identity. Without it everything is signed ad hoc: fine to
#   test the steps, refused by Gatekeeper on other Macs. AGNETA_KEYCHAIN names the keychain holding it, if not the
#   default (CI imports the certificate into a temporary one).
# AGNETA_SPARKLE_PUBLIC_KEY: Sparkle's EdDSA public key, built into the app with its update feed; a signed release
#   must have one.
# Notarization, with an identity: AGNETA_NOTARY_KEY (an App Store Connect API key's .p8 file), AGNETA_NOTARY_KEY_ID
#   and AGNETA_NOTARY_ISSUER; or AGNETA_NOTARY_PROFILE, a profile stored with `xcrun notarytool store-credentials`.
set -euo pipefail
cd "$(dirname "$0")/../.."
engines=all previous=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --engines) shift; engines=${1:?--engines all|goose} ;;
    --previous) shift; previous=(--previous "${1:?--previous needs a zip}") ;;
    *) echo "usage: release [--engines all|goose] [--previous <Agneta.zip>]" >&2; exit 2 ;;
  esac
  shift
done
[[ -z "$(git status --porcelain)" ]] || { echo "Commit first: a release is built from a clean checkout" >&2; exit 2; }
identity=${AGNETA_SIGN_IDENTITY:-}
version=${AGNETA_VERSION:-$(git describe --tags --exact-match --match 'v[0-9]*' 2>/dev/null | sed 's/^v//' || true)}
[[ -n "$version" || -z "$identity" ]] || { echo "A signed release needs a version: tag this commit v<version> or set AGNETA_VERSION" >&2; exit 2; }
export AGNETA_VERSION=${version:-0.0.0}
notary=()
if [[ -n "${AGNETA_NOTARY_KEY:-}" ]]; then
  notary=(--key "$AGNETA_NOTARY_KEY" --key-id "${AGNETA_NOTARY_KEY_ID:?with AGNETA_NOTARY_KEY}" --issuer "${AGNETA_NOTARY_ISSUER:?with AGNETA_NOTARY_KEY}")
elif [[ -n "${AGNETA_NOTARY_PROFILE:-}" ]]; then
  notary=(--keychain-profile "$AGNETA_NOTARY_PROFILE")
fi
[[ -z "$identity" || ${#notary[@]} -gt 0 ]] || { echo "A signed release is notarized: set AGNETA_NOTARY_KEY… or AGNETA_NOTARY_PROFILE" >&2; exit 2; }
[[ -z "$identity" || -n "${AGNETA_SPARKLE_PUBLIC_KEY:-}" ]] || { echo "A signed release updates itself: set AGNETA_SPARKLE_PUBLIC_KEY" >&2; exit 2; }
keychain=(); [[ -n "${AGNETA_KEYCHAIN:-}" ]] && keychain=(--keychain "$AGNETA_KEYCHAIN")
arch=$(uname -m); [[ "$arch" == aarch64 ]] && arch=arm64

# The bundle carries Goose only; with every engine, Codex's runtime (Node, codex-acp) is a download of its own, below.
scripts/dev/build-app --release --engines goose >/dev/null
app=build/Agneta.app
out=build/release
rm -rf "$out"; mkdir -p "$out"
name="Agneta-$AGNETA_VERSION-$arch"
entitlements=scripts/dev/entitlements

# Signs with the identity (secure timestamp, hardened runtime), or ad hoc without one.
sign() {
  if [[ -n "$identity" ]]; then codesign --force --timestamp --options runtime --sign "$identity" ${keychain[@]+"${keychain[@]}"} "$@"
  else codesign --force --options runtime --sign - "$@"; fi
}

# Submits a file for notarization and waits; anything but Accepted prints Apple's log and stops the release.
notarize() {
  local result id status
  result=$(xcrun notarytool submit "$1" "${notary[@]}" --wait --timeout 30m --output-format json) || true
  id=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read() or "{}").get("id", ""))' <<<"$result" 2>/dev/null || true)
  status=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read() or "{}").get("status", ""))' <<<"$result" 2>/dev/null || true)
  if [[ "$status" != Accepted ]]; then
    echo "notarization of $(basename "$1") ended '${status:-without an answer}': $result" >&2
    [[ -n "$id" ]] && xcrun notarytool log "$id" "${notary[@]}" >&2
    exit 1
  fi
  echo "notarized $(basename "$1") ($id)"
}

# Codex's runtime: Node and codex-acp, which only a Codex account needs, as Agneta-codex-runtime-<version>-<arch>.zip
# beside the release; the app downloads it when Codex is first used, pinned by Resources/codex-runtime.lock (its
# URL on this release, SHA-256 and size), written here before the app is signed.
if [[ "$engines" == all ]]; then
  scripts/fetch-codex "$arch" >/dev/null
  stage=$(mktemp -d "${TMPDIR:-/tmp}/agneta-runtime-XXXX")
  mkdir -p "$stage/codex-runtime"
  cp "Engines/bin/$arch/node-runtime/bin/node" "$stage/codex-runtime/node"
  cp -R "Engines/bin/$arch/codex-acp" "$stage/codex-runtime/codex-acp"
  # What the runtime is made of, before signing (a signature differs every build): its version names it, so a release
  # that changes any of it (Node, codex-acp, a dependency, Node's entitlements) is downloaded again, and one that
  # doesn't isn't.
  node_entitlements=$(shasum -a 256 "$entitlements/node.plist" | cut -d' ' -f1)
  contents=$( (cd "$stage/codex-runtime" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256; echo "$node_entitlements") | shasum -a 256 | cut -c1-12)
  sign --entitlements "$entitlements/node.plist" "$stage/codex-runtime/node"
  runtime_zip="$out/Agneta-codex-runtime-$AGNETA_VERSION-$arch.zip"
  (cd "$stage" && /usr/bin/ditto -c -k --keepParent codex-runtime "$OLDPWD/$runtime_zip")
  # As the app will run it: unpacked from the archive, Node runs JavaScript (its JIT under the signature) and codex-acp parses.
  check=$(mktemp -d "${TMPDIR:-/tmp}/agneta-runtime-check-XXXX")
  /usr/bin/ditto -x -k "$runtime_zip" "$check"
  [[ "$(env -i HOME="$check" "$check/codex-runtime/node" -e 'console.log([1, 2, 3].map(n => n * 2).join(","))')" == 2,4,6 ]] || { echo "Codex's runtime: Node doesn't run" >&2; exit 1; }
  env -i HOME="$check" "$check/codex-runtime/node" --check "$check/codex-runtime/codex-acp/dist/index.js" || { echo "Codex's runtime: codex-acp doesn't parse" >&2; exit 1; }
  rm -rf "$stage" "$check"
  runtime_version="node-$(/usr/bin/plutil -extract node.version raw -o - Engines/codex.lock)-codex-acp-$(/usr/bin/plutil -extract adapter.version raw -o - Engines/codex.lock)-$contents"
  runtime_sha=$(shasum -a 256 "$runtime_zip" | cut -d' ' -f1)
  runtime_size=$(stat -f %z "$runtime_zip")
  cat > "$app/Contents/Resources/codex-runtime.lock" <<LOCK
{
  "engine": "codex-runtime",
  "version": "$runtime_version",
  "assets": {
    "$arch": {"url": "https://github.com/olofd/agneta/releases/download/v$AGNETA_VERSION/$(basename "$runtime_zip")", "sha256": "$runtime_sha", "size": $runtime_size}
  }
}
LOCK
  python3 scripts/dev/sbom "$arch" "$app" "$app/Contents/Resources/sbom.cdx.json" goose >/dev/null
  echo "Codex's runtime: $(basename "$runtime_zip") ($(du -h "$runtime_zip" | cut -f1)), runs"
fi

if [[ -n "$identity" ]]; then
  # Inside out. Every program Agneta ships is signed with its identity: the engines' own vendor signatures are
  # replaced, since they carry entitlements a release mustn't (Node's allows debugging, which notarization refuses).
  # What each program may do beyond the hardened runtime is in scripts/dev/entitlements/<program>.plist.
  while IFS= read -r -d '' file; do
    [[ "$file" == "$app/Contents/MacOS/Agneta" || "$file" == */AgnetaTestClient.app/* || "$file" == */Sparkle.framework/* ]] && continue
    file -b "$file" | grep -q Mach-O || continue
    plist="$entitlements/$(basename "$file").plist"
    if [[ -f "$plist" ]]; then sign --entitlements "$plist" "$file"; else sign "$file"; fi
  done < <(find "$app/Contents" -type f -perm +111 -print0)
  # Sparkle is signed as Sparkle's documentation does it: its installer tool, its progress app, the framework.
  sparkle="$app/Contents/Frameworks/Sparkle.framework"
  for item in "$sparkle/Versions/B/Autoupdate" "$sparkle/Versions/B/Updater.app" "$sparkle"; do sign "$item"; done
  # The sandboxed test client keeps its own entitlements (App Sandbox, network client).
  sign --preserve-metadata=entitlements "$app/Contents/Resources/AgnetaTestClient.app"
fi
sign "$app"
codesign --verify --deep --strict "$app"

if [[ -n "$identity" ]]; then
  # Nothing in the bundle may be left with another signer, or none.
  team=$(codesign -dv "$app" 2>&1 | sed -n 's/^TeamIdentifier=//p')
  while IFS= read -r -d '' file; do
    file -b "$file" | grep -q Mach-O || continue
    signer=$(codesign -dv "$file" 2>&1 | sed -n 's/^TeamIdentifier=//p')
    [[ "$signer" == "$team" ]] || { echo "$file is signed by '${signer:-nobody}', not $team" >&2; exit 1; }
  done < <(find "$app/Contents" -type f -perm +111 -print0)
  echo "signed with $identity (team $team)"
  /usr/bin/ditto -c -k --keepParent "$app" "$out/notarize.zip"
  notarize "$out/notarize.zip"
  rm -f "$out/notarize.zip"
  xcrun stapler staple "$app"
  xcrun stapler validate "$app"
else
  echo "no AGNETA_SIGN_IDENTITY: signed ad hoc and not notarized, not for distribution" >&2
fi

# The zip Sparkle downloads: the stapled app.
/usr/bin/ditto -c -k --keepParent "$app" "$out/$name.zip"

# The DMG people download: the app and a link to Applications. Signed, notarized and stapled itself, so it opens
# without a warning and the app in it launches offline the first time.
staging=$(mktemp -d "${TMPDIR:-/tmp}/agneta-dmg-XXXX")
trap 'rm -rf "$staging"' EXIT
/usr/bin/ditto "$app" "$staging/Agneta.app"
ln -s /Applications "$staging/Applications"
# The disk shows Agneta's icon when it's open (Finder's sidebar and window, the desktop), not the plain disk: the
# volume icon is the app's .icns, flagged as the volume's custom icon, which takes a writable image, converted after.
cp "$app/Contents/Resources/AppIcon.icns" "$staging/.VolumeIcon.icns"
# The window: a dusk background with an arrow to Applications, icons placed over it (scripts/dev/dmg-layout).
mkdir "$staging/.background"
cp packaging/dmg/background.tiff "$staging/.background/background.tiff"
cp packaging/dmg/DS_Store "$staging/.DS_Store"
# Asks Spotlight and fseventsd to leave the volume alone, one suspect for what keeps it busy on a fresh runner (both
# markers are their documented opt-outs). They ship in the DMG as empty hidden files, beside .DS_Store.
touch "$staging/.metadata_never_index"
mkdir -p "$staging/.fseventsd"
touch "$staging/.fseventsd/no_log"
writable=$(mktemp -u "${TMPDIR:-/tmp}/agneta-dmg-rw-XXXX").dmg
mount=$(mktemp -d "${TMPDIR:-/tmp}/agneta-dmg-mount-XXXX")
hdiutil create -quiet -volname Agneta -srcfolder "$staging" -fs HFS+ -format UDRW -ov "$writable"
hdiutil attach -quiet -nobrowse -noautoopen -mountpoint "$mount" "$writable"
xcrun SetFile -a C "$mount"
# Something can still hold a volume just mounted on a fresh runner: scripts/dev/detach waits it out and says what.
scripts/dev/detach "$mount"
hdiutil convert -quiet "$writable" -format ULFO -ov -o "$out/$name.dmg"
rm -f "$writable"; rmdir "$mount" 2>/dev/null || true
if [[ -n "$identity" ]]; then
  codesign --force --timestamp --sign "$identity" ${keychain[@]+"${keychain[@]}"} "$out/$name.dmg"
  notarize "$out/$name.dmg"
  xcrun stapler staple "$out/$name.dmg"
  xcrun stapler validate "$out/$name.dmg"
fi

(cd "$out" && runtimes=(); for zip in Agneta-codex-runtime-*.zip; do [[ -e "$zip" ]] && runtimes+=("$zip"); done
  shasum -a 256 "$name.dmg" "$name.zip" ${runtimes[@]+"${runtimes[@]}"} > "SHA256SUMS-$arch.txt")
gatekeeper=(); [[ -n "$identity" ]] && gatekeeper=(--gatekeeper)
scripts/dev/smoke-test "$out/$name.dmg" ${gatekeeper[@]+"${gatekeeper[@]}"} ${previous[@]+"${previous[@]}"}
for file in "$out/$name.dmg" "$out/$name.zip"; do echo "$file ($(du -h "$file" | cut -f1))"; done
cat "$out/SHA256SUMS-$arch.txt"
