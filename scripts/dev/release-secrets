#!/bin/bash
# Puts the release keys into GitHub's `release` environment straight from the maintainer's Mac
# (docs/RELEASE_SETUP.md). Nothing secret is printed, passed on a command line or left on disk; the maintainer runs
# it, so no one else ever handles a key.
#   scripts/dev/release-secrets request
#     Makes Agneta's Developer ID key and the signing request to upload to Apple.
#   scripts/dev/release-secrets finish <developerID_application.cer> <AuthKey_XXXXXXXXXX.p8>
#     Puts the certificate (with its key) in the login keychain and the environment, the notarization key, Sparkle's
#     update key (made in the login keychain the first time) and the Homebrew tap token (asked for).
#   scripts/dev/release-secrets check
#     Says which of the environment's secrets and variables are set (names only).
set -euo pipefail
cd "$(dirname "$0")/../.."
repo=olofd/agneta env=release
work="$HOME/Library/Caches/agneta-build/release-request"
# LibreSSL, as macOS ships it: its .p12 files import into a macOS keychain, which OpenSSL 3's defaults don't.
openssl=/usr/bin/openssl
secrets=(DEVELOPER_ID_P12 DEVELOPER_ID_P12_PASSWORD ASC_KEY_P8 ASC_KEY_ID ASC_ISSUER_ID SPARKLE_ED_PRIVATE_KEY HOMEBREW_TAP_TOKEN)
variables=(AGNETA_SIGN_IDENTITY AGNETA_SPARKLE_PUBLIC_KEY)

# Each reads its value from standard input, so it never appears in a process list.
secret() { gh secret set "$1" --env "$env" --repo "$repo" >/dev/null && echo "set secret $1"; }
variable() { gh variable set "$1" --env "$env" --repo "$repo" --body "$2" >/dev/null && echo "set variable $1"; }

check() {
  local have missing=()
  have=$( { gh secret list --env "$env" --repo "$repo" --json name -q '.[].name'; gh variable list --env "$env" --repo "$repo" --json name -q '.[].name'; } )
  for name in "${secrets[@]}" "${variables[@]}"; do grep -qx "$name" <<<"$have" || missing+=("$name"); done
  if [[ ${#missing[@]} -eq 0 ]]; then echo "The release environment has everything: ${#secrets[@]} secrets and ${#variables[@]} variables."
  else echo "The release environment still lacks: ${missing[*]}"; return 1; fi
}

case "${1:-}" in
request)
  umask 077
  mkdir -p "$work"
  if [[ -f "$work/developer-id.key" ]]; then
    echo "A request is waiting already: $work/agneta.certSigningRequest (delete $work to start over)"
  else
    "$openssl" genrsa -out "$work/developer-id.key" 2048 2>/dev/null
    "$openssl" req -new -key "$work/developer-id.key" -subj "/CN=Agneta Developer ID" -out "$work/agneta.certSigningRequest"
    echo "Made $work/agneta.certSigningRequest"
  fi
  echo "Upload it at developer.apple.com → Certificates → + → Developer ID Application → G2 Sub-CA, and download the certificate."
  open -R "$work/agneta.certSigningRequest"
  ;;

finish)
  cer=${2:?usage: release-secrets finish <developerID_application.cer> <AuthKey_XXXXXXXXXX.p8>}
  p8=${3:?usage: release-secrets finish <developerID_application.cer> <AuthKey_XXXXXXXXXX.p8>}
  key="$work/developer-id.key"
  [[ -f "$key" ]] || { echo "No waiting request in $work: run 'release-secrets request' first" >&2; exit 2; }
  [[ -f "$cer" && -f "$p8" ]] || { echo "No such file: $([[ -f "$cer" ]] || echo "$cer ")$([[ -f "$p8" ]] || echo "$p8")" >&2; exit 2; }
  gh auth status >/dev/null 2>&1 || { echo "Sign in to GitHub first: gh auth login" >&2; exit 2; }
  umask 077
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/agneta-release-secrets-XXXX")
  trap 'rm -rf "$tmp"' EXIT

  # The certificate: Apple's .cer is DER. It must be a Developer ID Application certificate for the waiting key.
  "$openssl" x509 -inform DER -in "$cer" -out "$tmp/certificate.pem" 2>/dev/null || "$openssl" x509 -in "$cer" -out "$tmp/certificate.pem"
  [[ "$("$openssl" x509 -in "$tmp/certificate.pem" -noout -modulus)" == "$("$openssl" rsa -in "$key" -noout -modulus 2>/dev/null)" ]] \
    || { echo "$cer wasn't made from this Mac's waiting request" >&2; exit 1; }
  identity=$("$openssl" x509 -in "$tmp/certificate.pem" -noout -subject -nameopt multiline | sed -n 's/^ *commonName *= //p')
  [[ "$identity" == "Developer ID Application: "* ]] || { echo "$cer is '$identity', not a Developer ID Application certificate" >&2; exit 1; }
  # A random password, handed to openssl and GitHub on a file descriptor; the keychain copy needs none.
  "$openssl" rand -base64 32 | tr -d '\n' > "$tmp/password"
  "$openssl" pkcs12 -export -inkey "$key" -in "$tmp/certificate.pem" -name "Agneta Developer ID" -passout "file:$tmp/password" -out "$tmp/developer-id.p12"
  # The login keychain keeps the identity: the backup, and what signs releases built on this Mac.
  login=$(security default-keychain | sed -e 's/^ *"//' -e 's/"$//')
  security import "$key" -k "$login" -t priv -f openssl -T /usr/bin/codesign >/dev/null
  security import "$tmp/certificate.pem" -k "$login" >/dev/null
  echo "imported '$identity' into $login"
  base64 -i "$tmp/developer-id.p12" | secret DEVELOPER_ID_P12
  secret DEVELOPER_ID_P12_PASSWORD < "$tmp/password"
  variable AGNETA_SIGN_IDENTITY "$identity"

  # The notarization key. Its ID is in Apple's file name; the issuer is on the keys page.
  grep -q 'BEGIN PRIVATE KEY' "$p8" || { echo "$p8 isn't an App Store Connect API key (.p8)" >&2; exit 1; }
  key_id=$(basename "$p8" | sed -n 's/^AuthKey_\([A-Z0-9]*\)\.p8$/\1/p')
  [[ -n "$key_id" ]] || read -rp "The API key's Key ID: " key_id
  read -rp "The Issuer ID (above the keys table in App Store Connect): " issuer
  [[ "$issuer" =~ ^[0-9a-fA-F-]{36}$ ]] || { echo "'$issuer' doesn't look like an Issuer ID" >&2; exit 1; }
  secret ASC_KEY_P8 < "$p8"
  printf '%s' "$key_id" | secret ASC_KEY_ID
  printf '%s' "$issuer" | secret ASC_ISSUER_ID

  # Sparkle's update key, made once in the login keychain (account "agneta"); the keychain is where it is kept.
  sparkle=$(scripts/dev/sparkle-tools)
  "$sparkle/generate_keys" --account agneta -p >/dev/null 2>&1 || "$sparkle/generate_keys" --account agneta >/dev/null
  public=$("$sparkle/generate_keys" --account agneta -p)
  "$sparkle/generate_keys" --account agneta -x "$tmp/sparkle-private-key" >/dev/null
  secret SPARKLE_ED_PRIVATE_KEY < "$tmp/sparkle-private-key"
  variable AGNETA_SPARKLE_PUBLIC_KEY "$public"

  # The tap token, typed at a hidden prompt.
  read -rsp "The Homebrew tap token (github_pat_…; Enter to skip): " token; echo
  if [[ -n "$token" ]]; then printf '%s' "$token" | secret HOMEBREW_TAP_TOKEN; else echo "skipped HOMEBREW_TAP_TOKEN"; fi
  unset token

  rm -rf "$work"
  echo
  echo "Keep two things in your password manager: $p8 (Apple shows it only once), and Sparkle's private key"
  echo "(Keychain Access → login → \"Private key for signing Sparkle updates\", account agneta): without it,"
  echo "installed copies can never be updated again. Then delete $p8 and $cer."
  echo
  check
  ;;

check) check ;;

*) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
