#!/usr/bin/env python3
"""Turns a CHANGELOG.md section (stdin) into the small HTML Sparkle shows in its update window (stdout).

Links relative to the repository are made absolute against the base URL given (the release's tree on GitHub).
Usage: notes-html <base url>

It knows what the changelog uses: paragraphs, "- " lists, **bold**, `code` and [links](url). Everything else is
escaped and shown as text.
"""
import html, re, sys

base = sys.argv[1] if len(sys.argv) > 1 else ""

def absolute(url):
    return url if re.match(r"^[a-z]+:", url) or url.startswith("#") else base + url

def inline(text):
    text = html.escape(text, quote=False)
    text = re.sub(r"`([^`]+)`", r"<code>\1</code>", text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", text)
    return re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", lambda m: f'<a href="{html.escape(absolute(m.group(2)))}">{m.group(1)}</a>', text)

out, paragraph, items = [], [], []
def flush():
    if paragraph:
        out.append("<p>" + inline(" ".join(paragraph)) + "</p>"); paragraph.clear()
    if items:
        out.append("<ul>" + "".join(f"<li>{inline(i)}</li>" for i in items) + "</ul>"); items.clear()

for line in sys.stdin.read().splitlines():
    stripped = line.strip()
    if not stripped:
        flush()
    elif stripped.startswith("- "):
        if paragraph: flush()
        items.append(stripped[2:])
    elif items and line.startswith("  "):
        items[-1] += " " + stripped
    elif stripped.startswith("#"):
        flush(); out.append("<h3>" + inline(stripped.lstrip("#").strip()) + "</h3>")
    else:
        if items: flush()
        paragraph.append(stripped)
flush()
print("\n".join(out))
