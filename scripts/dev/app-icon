#!/bin/bash
# Redraws Agneta's app icons after a design change (scripts/dev/app-icon.swift): the release's, and the development
# build's, which is the same icon with a small hammer, so Agneta and Agneta Dev side by side tell apart.
# - packaging/AppIcon.icon/Assets/rings.png and background.png: the glass layer of the Liquid Glass icon and the evening
#   beneath it (packaging/AppIcon.icon, Icon Composer's format; its icon.json holds the layers' glass settings), and
#   packaging/AppIconDev.icon, the same with the hammer's layer added (Assets/hammer.png).
# - packaging/AppIcon/ and packaging/AppIconDev/: Assets.car (macOS 26) and the .icns (older macOS), compiled from them
#   with actool and committed, which build-app copies into the bundle. Compiled here, not in every build: actool
#   crashes under Xcode 26 on some macOS 15 Macs (seen on GitHub's macos-15 Apple silicon runner).
# - packaging/AppIcon.png and AppIconDev.png, previews of the icons as macOS renders them, for docs and review.
#   scripts/dev/app-icon
set -euo pipefail
cd "$(dirname "$0")/../.."
work=$(mktemp -d "${TMPDIR:-/tmp}/agneta-icon-XXXX")
trap 'rm -rf "$work"' EXIT
swift scripts/dev/app-icon.swift packaging/AppIcon.icon/Assets/rings.png 1024 rings >/dev/null
swift scripts/dev/app-icon.swift packaging/AppIcon.icon/Assets/background.png 1024 background >/dev/null
mkdir -p packaging/AppIconDev.icon/Assets
cp packaging/AppIcon.icon/Assets/rings.png packaging/AppIcon.icon/Assets/background.png packaging/AppIconDev.icon/Assets/
swift scripts/dev/app-icon.swift packaging/AppIconDev.icon/Assets/hammer.png 1024 hammer >/dev/null

cat > "$work/preview.swift" <<'SWIFT'
import AppKit
let icon = NSWorkspace.shared.icon(forFile: CommandLine.arguments[1])
let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: 1024, pixelsHigh: 1024, bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
                           isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
icon.draw(in: NSRect(x: 0, y: 0, width: 1024, height: 1024))
NSGraphicsContext.restoreGraphicsState()
try! rep.representation(using: .png, properties: [:])!.write(to: URL(filePath: CommandLine.arguments[2]))
SWIFT

# Compiles packaging/<name>.icon into packaging/<name>/ as build-app uses it, then previews it: in a bare bundle,
# macOS draws the bundle's icon.
icon() {
  local name=$1 app=$work/$1.app
  mkdir -p "packaging/$name"
  xcrun actool "packaging/$name.icon" --compile "packaging/$name" --platform macosx --minimum-deployment-target 14.0 \
    --app-icon "$name" --output-partial-info-plist "$work/$name.plist" --target-device mac >/dev/null
  mkdir -p "$app/Contents/Resources" "$app/Contents/MacOS"
  # A bundle without a program gets macOS's "can't open" badge on its icon.
  printf '#!/bin/sh\n' > "$app/Contents/MacOS/Preview"
  chmod +x "$app/Contents/MacOS/Preview"
  cp "packaging/$name/Assets.car" "packaging/$name/$name.icns" "$app/Contents/Resources/"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.objectivecoder.agneta.iconpreview.$name</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>Preview</string>
  <key>CFBundleIconFile</key><string>$name</string>
  <key>CFBundleIconName</key><string>$name</string>
</dict></plist>
PLIST
  swift "$work/preview.swift" "$app" "packaging/$name.png"
}
icon AppIcon
icon AppIconDev
echo "packaging/AppIcon.icon, AppIconDev.icon, AppIcon/, AppIconDev/, AppIcon.png, AppIconDev.png"
