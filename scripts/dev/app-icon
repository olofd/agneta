#!/bin/bash
# Redraws Agneta's app icon after a design change (scripts/dev/app-icon.swift):
# - packaging/AppIcon.icon/Assets/rings.png, the glass layer of the Liquid Glass icon (packaging/AppIcon.icon, Icon
#   Composer's format; its icon.json holds the background colour and the glass settings). build-app compiles it with
#   actool into Assets.car for macOS 26 and a rendered AppIcon.icns for older macOS.
# - packaging/AppIcon.png, a preview of the icon as macOS renders it, for docs and review.
#   scripts/dev/app-icon
set -euo pipefail
cd "$(dirname "$0")/../.."
work=$(mktemp -d "${TMPDIR:-/tmp}/agneta-icon-XXXX")
trap 'rm -rf "$work"' EXIT
swift scripts/dev/app-icon.swift packaging/AppIcon.icon/Assets/rings.png 1024 rings >/dev/null
# The preview: compile as build-app does, put it in a bare bundle, and ask macOS for that bundle's icon.
app=$work/Preview.app
mkdir -p "$app/Contents/Resources" "$app/Contents/MacOS"
# A bundle without a program gets macOS's "can't open" badge on its icon.
printf '#!/bin/sh\n' > "$app/Contents/MacOS/Preview"
chmod +x "$app/Contents/MacOS/Preview"
xcrun actool packaging/AppIcon.icon --compile "$app/Contents/Resources" --platform macosx --minimum-deployment-target 14.0 \
  --app-icon AppIcon --output-partial-info-plist "$work/partial.plist" --target-device mac >/dev/null
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.objectivecoder.agneta.iconpreview</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>Preview</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIconName</key><string>AppIcon</string>
</dict></plist>
PLIST
cat > "$work/preview.swift" <<'SWIFT'
import AppKit
let icon = NSWorkspace.shared.icon(forFile: CommandLine.arguments[1])
let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: 1024, pixelsHigh: 1024, bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
                           isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
icon.draw(in: NSRect(x: 0, y: 0, width: 1024, height: 1024))
NSGraphicsContext.restoreGraphicsState()
try! rep.representation(using: .png, properties: [:])!.write(to: URL(filePath: CommandLine.arguments[2]))
SWIFT
swift "$work/preview.swift" "$app" packaging/AppIcon.png
echo "packaging/AppIcon.icon/Assets/rings.png, packaging/AppIcon.png"
