#!/bin/bash
# Wraps agneta-testclient in an app bundle signed (ad hoc) with Mac App Store
# entitlements only: App Sandbox and outgoing network. Proves a sandboxed app
# can reach Agneta on loopback. Output: .build/AgnetaTestClient.app
set -euo pipefail
cd "$(dirname "$0")/../.."
swift build --product agneta-testclient >/dev/null
app=.build/AgnetaTestClient.app
mkdir -p "$app/Contents/MacOS"
cp .build/debug/agneta-testclient "$app/Contents/MacOS/agneta-testclient"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.objectivecoder.agneta.testclient</string>
  <key>CFBundleName</key><string>Agneta Test Client</string>
  <key>CFBundleExecutable</key><string>agneta-testclient</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
cat > .build/testclient.entitlements <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
</dict></plist>
PLIST
codesign --force --sign - --entitlements .build/testclient.entitlements --options runtime "$app"
codesign -d --entitlements - "$app" 2>/dev/null | grep -c "app-sandbox" >/dev/null && echo "$app (sandboxed)"
