#!/bin/bash
# The one-shot Swift reformat (CONTRIBUTING.md, Static checks). Formats every Swift file with the pinned
# swift-format, switches the format check from the lines a change touches to every line (scripts/check, the Swift
# format CI job and their docs), and removes this script. It commits nothing: it verifies, then prints the commits.
# Run it once, on main's tip with no other Swift work about to merge.
#   scripts/dev/reformat-swift
set -euo pipefail
cd "$(dirname "$0")/../.."
[[ -z "$(git status --porcelain)" ]] || { echo "reformat-swift: the working tree has changes; commit or stash them first" >&2; exit 1; }
want=$(sed -n 's/^swift_format_version=//p' scripts/check)
have=$(xcrun swift-format --version)
[[ "$have" == "$want" ]] || { echo "reformat-swift: swift-format $have, but scripts/check pins $want" >&2; exit 1; }

echo "== Formatting every Swift file with swift-format $have"
scripts/dev/swift-format-changed --all --fix

echo "== Switching the check to every line"
python3 - <<'EOF'
import sys


def switch(path, *pairs):
    with open(path, encoding="utf-8") as file:
        text = file.read()
    for old, new in pairs:
        if text.count(old) != 1:
            sys.exit(f"reformat-swift: {path} no longer holds the text to switch:\n{old}")
        text = text.replace(old, new)
    with open(path, "w", encoding="utf-8") as file:
        file.write(text)


switch("scripts/check", (
    """#   swift       swift-format (.swift-format) on the lines changed since the base, until the one-shot reformat
#               (CONTRIBUTING.md, Static checks); the whole tree's findings are reported, never failed. Also the
#               format check's own tests (scripts/dev/tests)""",
    """#   swift       swift-format (.swift-format) on every line of every Swift file; also the format check's own tests
#               (scripts/dev/tests)"""), (
    "# --fix repairs what's mechanical: whitespace in tracked files, and Swift formatting around the changed lines.",
    "# --fix repairs what's mechanical: whitespace in tracked files, and Swift formatting."), (
    """# AGNETA_CHECK_BASE   what "changed" is measured against (default: the merge base with origin/main, or main).
""", ""), (
    """  # After the one-shot reformat (CONTRIBUTING.md, Static checks), --all here makes every line count.
  local args=(--report)
  [[ -n "${AGNETA_CHECK_BASE:-}" ]] && args+=(--base "$AGNETA_CHECK_BASE")
""", """  local args=(--all)
"""))

switch(".github/workflows/ci.yml", (
    """  # swift-format comes with Xcode, so it runs on a Mac, with the version scripts/check pins. Until the one-shot
  # reformat (CONTRIBUTING.md, Static checks) only the lines a change touches must be formatted; the log reports the
  # whole tree's findings.""",
    """  # swift-format comes with Xcode, so it runs on a Mac, with the version scripts/check pins: every line of every Swift
  # file must be formatted."""), (
    """        with:
          fetch-depth: 0 # the base the changed lines are measured against
          persist-credentials: false

      # The newest Xcode""", """        with:
          persist-credentials: false

      # The newest Xcode"""), (
    """      # A pull request is measured against its base branch, a push against what main was before it. A base that
      # isn't in the history (a new branch, a force push, a run by hand) falls back to the last commit.
      - name: Check the changed lines
        env:
          AGNETA_REQUIRE_TOOLS: "1"
          BASE: ${{ github.event_name == 'pull_request' && format('origin/{0}', github.base_ref) || github.event.before }}
        run: |
          base=$BASE
          git rev-parse --verify --quiet "${base:-none}^{commit}" > /dev/null || base=HEAD^
          AGNETA_CHECK_BASE=$base scripts/check swift
""", """      - name: Check the formatting
        env:
          AGNETA_REQUIRE_TOOLS: "1"
        run: scripts/check swift
"""))

switch("CONTRIBUTING.md", (
    "Most of the code predates it, so for now only the lines a change touches must be formatted; `scripts/check swift "
    "--fix` formats the statements around them, and the check also reports the whole tree's findings without failing. "
    "Once the whole tree has been reformatted in a commit of its own, the check covers every line.",
    "Every line must be formatted; `scripts/check swift --fix` formats them. The whole tree was reformatted in one "
    "commit, which `.git-blame-ignore-revs` lets `git blame` look past (`git config blame.ignoreRevsFile "
    ".git-blame-ignore-revs`)."),)

switch("docs/CI.md", (
    "on the lines changed since the base, a rename counting only its edited lines; the whole tree's findings are "
    "reported; the check's own tests",
    "on every line; the check's own tests"), (
    "The Swift format job measures a pull request against its base branch and a push against what `main` was before "
    "it. ", ""))
EOF
git rm -q scripts/dev/reformat-swift

echo "== Verifying"
scripts/dev/swift-format-changed --all
scripts/check swift whitespace
swift build --build-tests --force-resolved-versions -Xswiftc -warnings-as-errors
git diff --shortstat

cat <<'EOF'
== Done; nothing is committed. Next:
  AGNETA_REQUIRE_ENGINES=1 swift test   # with the pinned engines fetched (scripts/fetch-engines --engine all)
  git add -A
  git -c user.name="Olof Dahlbom" -c user.email="933408+olofd@users.noreply.github.com" commit -m "Format every Swift file with swift-format" -m "<why, and the numbers above>"
  { echo "# Format every Swift file with swift-format"; git rev-parse HEAD; } > .git-blame-ignore-revs
  git add .git-blame-ignore-revs
  git -c user.name="Olof Dahlbom" -c user.email="933408+olofd@users.noreply.github.com" commit -m "Have git blame look past the reformat"
Branches still open: run scripts/dev/swift-format-changed --all --fix on them before merging main in.
EOF
