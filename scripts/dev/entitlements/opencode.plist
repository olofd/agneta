<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OpenCode, a Bun-compiled binary: Bun's JIT needs these three (bun.com, "Codesign a single-file JavaScript
     executable on macOS"), and Bun loads native modules it unpacks at run time, which library validation would
     refuse. Its vendor signature also allows DYLD_ environment variables; Agneta sets the engine's environment,
     so that one is left out. -->
<plist version="1.0"><dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-executable-page-protection</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
